# Namuna sozlamalar fayli.
#
# Ishlatish:  cp .env.example .env   (Windows: copy .env.example .env)
# Keyin .env dagi qiymatlarni to'ldiring.
#
# DIQQAT: .env faylini HECH QACHON git'ga qo'shmang — u .gitignore da.


# --- Asosiy ---------------------------------------------------------------

# Ishlab chiqishda True, serverda ALBATTA False (yoki umuman yozmang).
DEBUG=True

# Maxfiy kalit. Yangisini yaratish:
#   python manage.py shell -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Serverda bu qiymat bo'lmasa loyiha ishga tushmaydi.
SECRET_KEY=

# Sayt qaysi domenlarda ishlaydi (vergul bilan).
# Masalan: blogy.uz,www.blogy.uz
ALLOWED_HOSTS=localhost,127.0.0.1

# HTTPS orqali forma yuborish uchun (Django 4+ talabi).
# Masalan: https://blogy.uz,https://www.blogy.uz
CSRF_TRUSTED_ORIGINS=


# --- Ma'lumotlar bazasi ---------------------------------------------------

# Bo'sh qoldirilsa SQLite ishlatiladi (db.sqlite3).
# PostgreSQL uchun:
#   DATABASE_URL=postgres://foydalanuvchi:parol@host:5432/dbnomi
DATABASE_URL=


# --- Xavfsizlik (faqat DEBUG=False bo'lganda ta'sir qiladi) ---------------

# Reverse-proxy (nginx/Render/Railway) o'zi HTTPS ga yo'naltirsa False qiling.
SECURE_SSL_REDIRECT=True

# HSTS — brauzer "faqat HTTPS" qoidasini shuncha soniya eslab qoladi.
# Boshida kichik qiymat bilan sinang; hammasi ishlagach 31536000 (1 yil).
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False


# --- Loglar ---------------------------------------------------------------

LOG_LEVEL=INFO
